# Secrets and migration artifacts must never reach deployment file storage.
# Vercel CLI does not apply .gitignore when .vercelignore exists, so this file
# repeats the critical exclusions explicitly. Keep it in parity with .gitignore
# for secret-bearing paths — scripts/check-deploy-hygiene.mjs enforces it in CI.
scripts/neon-poc/out/
.env*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
*credentials*.json
service-account*.json
.npmrc
.netrc
.secrets*
*.tar.gz
*.zip
*.dump
*.sqlite
*.sqlite3
# Tenant data and agent/tooling scratch (gitignored but uploaded without these).
.tmp/
logs/
.agent-dispatcher/
.agent-harness/
env.telegram
**/.config/moneyflow/telegram.env
# Build/dev artifacts (gitignored paths the uploader must also skip).
.next/
.vercel/
node_modules/
supabase/.temp/
*.tsbuildinfo
next-env.d.ts
output/
coverage/
test-results/
playwright-report/
blob-report/
out/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.playwright-cli/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/public/models/*.tar.gz
/public/models/*.zip
