<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 backup rules (android:fullBackupContent).

     Same contract as data_extraction_rules.xml: the shared_preferences
     file holds the session token, the offline ledger snapshot and
     queued captures, so the whole file stays off Auto Backup — a
     restored phone re-authenticates instead of resurrecting a stale
     credential. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
</full-backup-content>
