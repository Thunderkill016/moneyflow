<?xml version="1.0" encoding="utf-8"?>
<!-- AppWidgetProviderInfo — a compact 2x1 launch affordance. updatePeriod
     is 0: the widget shows no live data and never needs re-polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="56dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick_capture"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_capture_description" />
