<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout — only widget-safe views (LinearLayout/TextView/
     Button) and no theme-dependent attributes, so it renders inside any
     launcher. The data block opens the app (tap→app honesty); the
     button carries the capture intent. Values are filled by
     QuickCaptureWidgetProvider from the last-known widget_snapshot —
     the "—" defaults below are also the no-data state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_balance_label"
                android:textColor="@color/widget_dim_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_balance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_no_value"
                android:textColor="@color/widget_title_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_safespend_label"
                android:textColor="@color/widget_dim_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_safespend_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_no_value"
                android:textColor="@color/widget_title_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_open_app"
            android:textColor="@color/widget_dim_text"
            android:textSize="10sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_capture_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="88dp"
        android:text="@string/widget_capture_button"
        android:textColor="@color/widget_button_text"
        android:background="@drawable/widget_button_background" />
</LinearLayout>
