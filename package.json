  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/core/engine/engine.test.ts src/core/storage/storage.test.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:deploy-hygiene": "node scripts/check-deploy-hygiene.mjs",
    "check:workflow-pins": "node scripts/check-workflow-pins.mjs",
    "check:migrations": "node scripts/check-migration-identity.mjs",
    "check:rls": "bash scripts/check-rls-migrations.sh",
    "test:ci-policy": "node --test scripts/check-workflow-pins.test.mjs scripts/probe-health.test.mjs scripts/classify-ci-changes.test.mjs scripts/deploy-prod.test.mjs",
    "verify:fast": "npm run check:deploy-hygiene && npm run check:architecture && npm run check:workflow-pins && npm run test:ci-policy && npm run lint && npm run typecheck && npm test",
    "verify:prepush": "npm run verify:fast && npm run build"
  },
