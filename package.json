{
  "name": "moneyflow",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <23"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "next experimental-analyze",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/lib/*/*.test.ts",
    "verify:fast": "npm run check:knowledge && npm run check:architecture && npm run lint && npm run typecheck && npm test",
    "verify:prepush": "npm run verify:fast && npm run build",
    "agent:doctor": "node scripts/agent-doctor-entry.mjs",
    "plan:resolve": "node scripts/plan-selection.mjs",
    "agent:dispatch": "node scripts/agent-harness/cli.mjs --once",
    "agent:dispatch:watch": "node scripts/agent-harness/cli.mjs --watch",
    "test:agent-runtime": "node --test scripts/agent-harness/context.test.mjs scripts/agent-harness/journal.test.mjs scripts/agent-harness/legacy-migration.test.mjs scripts/agent-harness/providers.test.mjs scripts/agent-harness/runtime.test.mjs scripts/agent-harness/command-guard.test.mjs",
    "test:agent-harness": "node --test scripts/agent-policy.test.mjs scripts/agent-doctor.test.mjs scripts/plan-selection.test.mjs scripts/agent-doctor-entry.test.mjs scripts/design-evaluation.test.mjs scripts/agent-harness/context.test.mjs scripts/agent-harness/journal.test.mjs scripts/agent-harness/legacy-migration.test.mjs scripts/agent-harness/providers.test.mjs scripts/agent-harness/runtime.test.mjs scripts/agent-harness/command-guard.test.mjs",
    "test:load:contracts": "node --experimental-strip-types --test src/lib/performance-budgets.test.ts",
    "test:load:public": "k6 run tests/load/public-smoke.js",
    "test:load:dashboard": "k6 run tests/load/authenticated-dashboard.js",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:workflow-pins": "node scripts/check-workflow-pins.mjs",
    "check:migrations": "node scripts/check-migration-identity.mjs",
    "check:prove-evidence": "node scripts/check-prove-evidence.mjs",
    "check:knowledge": "node scripts/plan-authority.mjs && node scripts/lifecycle-projection.mjs && node scripts/check-project-knowledge.mjs",
    "check:deployment-env": "node scripts/check-deployment-env.mjs --force",
    "check:css-ownership": "node scripts/check-css-ownership.mjs",
    "check:ui-migration": "node scripts/check-ui-migration-diff.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "ci:status": "node scripts/watch-pr-ci.mjs --once",
    "ci:watch": "node scripts/watch-pr-ci.mjs",
    "test:ci-policy": "node --test scripts/check-release-version.test.mjs scripts/check-workflow-pins.test.mjs scripts/probe-health.test.mjs scripts/check-prove-evidence.test.mjs scripts/classify-ci-changes.test.mjs scripts/ci-retry-graph.test.mjs scripts/check-ui-migration-diff.test.mjs scripts/watch-pr-ci.test.mjs scripts/project-knowledge-contract.test.mjs scripts/plan-authority.test.mjs scripts/plan-selection.test.mjs scripts/lifecycle-projection.test.mjs scripts/agent-policy.test.mjs scripts/agent-doctor.test.mjs scripts/agent-doctor-entry.test.mjs scripts/agent-harness/context.test.mjs scripts/agent-harness/journal.test.mjs scripts/agent-harness/legacy-migration.test.mjs scripts/agent-harness/providers.test.mjs scripts/agent-harness/runtime.test.mjs scripts/agent-harness/command-guard.test.mjs",
    "mvp-verify": "bash scripts/mvp-verify.sh",
    "check:rls": "bash scripts/check-rls-migrations.sh",
    "test:db": "SUPABASE_TELEMETRY_DISABLED=1 npx supabase test db",
    "verify:archive-producer": "bash scripts/verify-archive-producer.sh",
    "verify:archive-round-trip": "bash scripts/verify-archive-producer.sh supabase/fixtures/restore_round_trip_fixture.sql",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "test:e2e:install": "playwright install chromium webkit",
    "design:capture": "playwright test -c playwright.design.config.ts",
    "design:check": "node scripts/check-design-evaluation.mjs",
    "test:ui-audit": "playwright test -c playwright.audit.config.ts",
    "test:ui-audit:pr": "playwright test -c playwright.audit.config.ts --project=chromium-phone-320 --project=chromium-android-360 --project=chromium-iphone-390 --project=chromium-capture-constrained --project=chromium-tablet-portrait --project=chromium-tablet-landscape --project=chromium-desktop-1366 --project=chromium-wide-1440 --project=chromium-phone-dark --project=chromium-desktop-dark --project=webkit-iphone --project=webkit-tablet --project=chromium-text-200-phone --project=chromium-keyboard-desktop --project=chromium-wcag",
    "test:ui-audit:firefox": "playwright test -c playwright.audit.config.ts --project=firefox-desktop",
    "check:dead-css": "node scripts/check-dead-css-reachable.mjs",
    "check:code-css-ownership": "node scripts/check-code-css-ownership.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.110.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
