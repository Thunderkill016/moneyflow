{
  "name": "moneyflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "next experimental-analyze",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/lib/*/*.test.ts",
    "check:knowledge": "node scripts/check-project-knowledge.mjs",
    "check:deployment-env": "node scripts/check-deployment-env.mjs --force",
    "check:css-ownership": "node scripts/check-css-ownership.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "mvp-verify": "bash scripts/mvp-verify.sh",
    "check:rls": "bash scripts/check-rls-migrations.sh",
    "test:db": "SUPABASE_TELEMETRY_DISABLED=1 npx supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "test:ui-audit": "playwright test -c playwright.audit.config.ts",
    "test:ui-audit:pr": "playwright test -c playwright.audit.config.ts --project=chromium-phone-320 --project=chromium-android-360 --project=chromium-iphone-390 --project=chromium-tablet-portrait --project=chromium-tablet-landscape --project=chromium-desktop-1366 --project=chromium-wide-1440 --project=chromium-phone-dark --project=chromium-desktop-dark --project=webkit-iphone --project=webkit-tablet --project=chromium-text-200-phone --project=chromium-keyboard-desktop",
    "test:ui-audit:firefox": "playwright test -c playwright.audit.config.ts --project=firefox-desktop",
    "check:dead-css": "node scripts/check-dead-css.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.3",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "postcss": "8.5.19",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
