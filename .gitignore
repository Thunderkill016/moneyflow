# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/playwright/
# playwright.audit.config.ts writes here, and only /output/playwright/ was listed —
# so traces and error contexts from the cross-device audit showed up as untracked.
/output/playwright-audit/
# playwright.auth.config.ts writes here.
/output/playwright-auth/
# playwright.design.config.ts writes generated visual evidence here.
/output/design-harness/
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# scripts/verify-archive-producer.sh writes the exported archive here. It holds a
# whole tenant's ledger, so it must never be committed.
/.tmp/

# agent / local runtime logs (never commit)
/logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Telegram secrets
.env.telegram

**/.config/moneyflow/telegram.env
