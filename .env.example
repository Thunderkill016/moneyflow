# Copy to .env.local for development. Production values belong in Vercel Project Settings.
NEXT_PUBLIC_APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required only when NEXT_PUBLIC_APP_MODE=authenticated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Auth CAPTCHA. Configure the Turnstile secret only in Supabase Auth;
# this public site key is safe for browser code. Enable only after both values
# are configured and the auth browser smoke has passed.
NEXT_PUBLIC_AUTH_CAPTCHA_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional comma-separated hostnames that should redirect to NEXT_PUBLIC_SITE_URL.
# Example: old-app.example.com,older-app.example.com
LEGACY_SITE_HOSTS=

# Optional comma-separated OAuth client ids allowed to call write capabilities
# (candidates.propose). Unset/empty denies all third-party write clients;
# first-party sessions always pass. See src/server/capabilities/write-policy.ts.
CAPABILITY_WRITE_CLIENT_IDS=
