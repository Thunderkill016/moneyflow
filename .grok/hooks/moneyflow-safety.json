{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command|Edit|Write|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/pre-tool-safety.sh",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
